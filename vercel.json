{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/tk-voting",
      "schedule": "0 4 * * 1"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.politiekprofiel.nl" }],
      "destination": "https://politiekprofiel.nl/:path*",
      "permanent": true
    }
  ]
}
